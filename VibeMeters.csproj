<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\VibeMeters.ico</ApplicationIcon>
    <Version>1.4.12</Version>
    <AssemblyName>VibeMeters</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <DebugType>embedded</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);runtime\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests\**" /><Resource Include="Assets\VibeMeters.ico" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="VibeMeters.Tests" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources\Strings.en.txt" WithCulture="false" LogicalName="VibeMeters.Resources.Strings.en.txt" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Taskbar\*.png" LogicalName="VibeMeters.Taskbar.%(Filename)%(Extension)" />
    <EmbeddedResource Include="docs\third-party\LobeIcons-LICENSE.txt" LogicalName="VibeMeters.Taskbar.LICENSE.txt" />
  </ItemGroup>
</Project>
