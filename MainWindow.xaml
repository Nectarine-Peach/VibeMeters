<Window x:Class="VibeMeters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeMeters" Width="380" Height="536" MinWidth="350" MinHeight="470"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Foreground="#E9EDF5" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#949CAD"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#B8C0CF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#28303E"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#35425A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C4CCDA"/><Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#303643"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                    <Border x:Name="PART_Track" Background="Transparent"/>
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2.5"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="17" Background="#141922" BorderBrush="#343B49" BorderThickness="1" Padding="18,14,18,13">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,17" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="VibeMeters" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="나의 AI 사용량" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PinButton" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="13" Click="Pin_Click" ToolTip="항상 위에 표시" AutomationProperties.Name="항상 위에 표시"/>
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="Minimize_Click" ToolTip="작업표시줄로 최소화" AutomationProperties.Name="최소화"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Click="Hide_Click" ToolTip="트레이로 숨기기" AutomationProperties.Name="트레이로 숨기기"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border CornerRadius="12" Background="#1D242E" BorderBrush="#303C43" BorderThickness="1" Padding="15,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Codex" FontWeight="SemiBold" FontSize="15" Foreground="#8BE2C3"/><TextBlock x:Name="CodexPlan" Text="연결 확인 중" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
                        <StackPanel x:Name="CodexRows"/>
                        <TextBlock x:Name="CodexMessage" Text="사용량을 불러오고 있습니다…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/>
                        <Button x:Name="CodexConnectButton" Content="사용량 페이지 열기 ↗" HorizontalAlignment="Left" FontSize="10" Padding="0,7,0,0" Click="CodexConnect_Click" ToolTip="브라우저에서 Codex 사용량 열기" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="#242329" BorderBrush="#42353A" BorderThickness="1" Padding="15,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Claude" FontWeight="SemiBold" FontSize="15" Foreground="#ECA98C"/><TextBlock x:Name="ClaudePlan" Text="연결 확인 중" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
                        <StackPanel x:Name="ClaudeRows"/>
                        <TextBlock x:Name="ClaudeMessage" Text="사용량을 불러오고 있습니다…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/>
                        <Button x:Name="ClaudeConnectButton" Content="사용량 페이지 열기 ↗" HorizontalAlignment="Left" FontSize="10" Padding="0,7,0,0" Click="ClaudeConnect_Click" ToolTip="브라우저에서 Claude 사용량 열기" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="계정의 구독 한도 · 남은 사용량 기준" Foreground="#697586" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel></ScrollViewer>
            <Border x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" Background="#1D242F" CornerRadius="10" Padding="13" Margin="0,11,0,8">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="새로고침 간격" VerticalAlignment="Center"/>
                        <ComboBox x:Name="IntervalCombo" Grid.Column="1" Width="124" SelectedIndex="2" SelectionChanged="Interval_SelectionChanged" AutomationProperties.Name="새로고침 간격">
                            <ComboBoxItem Content="30초" Tag="30"/><ComboBoxItem Content="1분" Tag="60"/><ComboBoxItem Content="2분" Tag="120"/><ComboBoxItem Content="5분" Tag="300"/><ComboBoxItem Content="15분" Tag="900"/><ComboBoxItem Content="수동" Tag="0"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="TaskbarCheck" Content="작업표시줄에 표시" Click="Taskbar_Click"/>
                    <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 실행" Click="Startup_Click"/>
                    <TextBlock Text="최소화해도 트레이에서 계속 갱신합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="연결 준비 중" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="235"/><TextBlock x:Name="LastUpdatedText" Foreground="#697586" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Click="Refresh_Click" ToolTip="지금 새로고침 (F5)" AutomationProperties.Name="지금 새로고침"/>
                <Button Grid.Column="2" x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Click="Settings_Click" ToolTip="설정" AutomationProperties.Name="설정"/>
            </Grid>
        </Grid>
    </Border>
</Window>


