   <Border Grid.Row="2" Style="{StaticResource Group}"><StackPanel><TextBlock Text="계정 연결" Style="{StaticResource Section}"/><UniformGrid Columns="3"><Button x:Name="CodexLoginButton" Content="Codex 로그인 ↗" Click="CodexLogin_Click" FontSize="10" Padding="4,7" Margin="0,0,5,0"/><Button x:Name="ClaudeLoginButton" Content="Claude 로그인 ↗" Click="ClaudeLogin_Click" FontSize="10" Padding="4,7" Margin="0,0,5,0"/><Button x:Name="GeminiLoginButton" Content="Gemini 로그인 ↗" Click="GeminiLogin_Click" FontSize="10" Padding="4,7"/></UniformGrid><TextBlock x:Name="LoginStatusText" Text="로그인하면 자동으로 다시 확인합니다." Foreground="{DynamicResource SecondaryText}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="자동 저장 · Claude 조회는 최소 2분, Gemini는 5분 간격" Foreground="{DynamicResource MutedText}" FontSize="10" VerticalAlignment="Bottom"/>
